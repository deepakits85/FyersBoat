@model FyersLoginWeb.Models.DashboardViewModel
@{
    ViewData["Title"] = "Live Dashboard";
    string pf = Model.UsePortfolio ? "true" : "false";
    string BtnCls(string m) => "btn " + (Model.ModeFilter == m ? "btn-primary" : "btn-outline-primary");
}
<meta http-equiv="refresh" content="30">

<div class="d-flex justify-content-between align-items-center" style="max-width:1150px;">
    <h2 class="mb-0">📊 Live Dashboard</h2>
    <div class="text-end" style="font-size:0.9rem;">
        @Model.Now.ToString("dd-MMM-yyyy HH:mm:ss")<br />
        @if (Model.MarketOpen)
        {
            <span class="badge bg-success">MARKET OPEN</span>
        }
        else
        {
            <span class="badge bg-secondary">MARKET CLOSED</span>
        }
        @if (Model.TokenValid)
        {
            <span class="badge bg-success">Token OK</span>
        }
        else
        {
            <a href="/Auth" class="badge bg-danger text-decoration-none">Token expired — login</a>
        }
        <span class="text-muted">(auto-refresh 30s)</span>
    </div>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger mt-2">@Model.Error</div>
}
else
{
    @* ---- Mode filter + Portfolio toggle ---- *@
    <div class="d-flex gap-2 flex-wrap my-2" style="max-width:1150px;">
        <div class="btn-group btn-group-sm" role="group">
            <a href="/Strategy/Dashboard?mode=all&portfolio=@pf" class="@BtnCls("all")">All</a>
            <a href="/Strategy/Dashboard?mode=live&portfolio=@pf" class="@BtnCls("live")">Live (@Model.LiveCount)</a>
            <a href="/Strategy/Dashboard?mode=backtest&portfolio=@pf" class="@BtnCls("backtest")">Backtest</a>
        </div>
        <div class="btn-group btn-group-sm" role="group" title="30-min gap + priority Nifty>SENSEX>BankNifty + max 2 SL/din">
            <a href="/Strategy/Dashboard?mode=@Model.ModeFilter&portfolio=true" class="btn @(Model.UsePortfolio ? "btn-success" : "btn-outline-success")">📁 Portfolio ON</a>
            <a href="/Strategy/Dashboard?mode=@Model.ModeFilter&portfolio=false" class="btn @(!Model.UsePortfolio ? "btn-secondary" : "btn-outline-secondary")">Raw</a>
        </div>
    </div>
    @if (Model.UsePortfolio)
    {
        <div class="small text-muted mb-1" style="max-width:1150px;">
            📁 Portfolio rules ON: consecutive trades me <b>30-min gap</b> · priority Nifty→SENSEX→BankNifty · din me max 2 SL.
            <b>@Model.PortfolioSkipped</b> trade in rules se skip huए. (Reference max-wait 90 min engine me — late entries pehle hi drop.)
        </div>
    }

    @* ---- Bot (paper) live positions ---- *@
    <div class="card my-2" style="max-width:1150px;border-color:#0d6efd;">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span><b>🤖 Bot positions</b> <span class="badge bg-warning text-dark">PAPER</span>
                    <span class="text-muted small">— koi real order nahi</span></span>
                @{
                    var openPos = Model.BotPositions.Count(p => p.State != "CLOSED");
                    var closedPos = Model.BotPositions.Where(p => p.State == "CLOSED").ToList();
                    decimal botR = System.Math.Round(closedPos.Sum(p => p.RealizedR), 2);
                }
                <span class="small">
                    <span class="badge bg-primary">@openPos open</span>
                    <span class="badge bg-secondary">@closedPos.Count closed</span>
                    <span class="@(botR >= 0 ? "text-success" : "text-danger")">net @botR R</span>
                </span>
            </div>
            @if (Model.BotPositions.Count == 0)
            {
                <div class="text-muted small">Abhi koi position nahi. Market hours me fresh signal aane par bot yahan entry dikhायega (state: ENTRY_PENDING → OPEN → CLOSED).</div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="table table-sm table-bordered mb-0" style="min-width:820px;font-size:0.83rem;">
                        <thead class="table-light">
                            <tr><th>Entry</th><th>Option</th><th>Side</th><th class="text-end">Qty</th>
                                <th class="text-end">Entry ₹</th><th class="text-end">SL</th><th class="text-end">Target</th>
                                <th>State</th><th>Outcome</th><th class="text-end">R</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.BotPositions.Take(40))
                            {
                                string rcls = p.State != "CLOSED" ? "table-primary"
                                            : p.Outcome == "TargetHit" ? "table-success"
                                            : p.Outcome == "StopLossHit" ? "table-danger"
                                            : p.Outcome == "TimeExit" ? "table-info" : "";
                                <tr class="@rcls">
                                    <td>@p.EntryTime.ToString("dd-MMM HH:mm")</td>
                                    <td style="font-size:0.8rem;">@p.Symbol.Replace("NSE:", "").Replace("BSE:", "")</td>
                                    <td>@p.Side</td>
                                    <td class="text-end">@p.Qty</td>
                                    <td class="text-end">@p.Entry</td>
                                    <td class="text-end">@p.SL</td>
                                    <td class="text-end">@p.Target</td>
                                    <td><span class="badge @(p.State == "OPEN" ? "bg-primary" : p.State == "CLOSED" ? "bg-secondary" : "bg-info text-dark")">@p.State</span></td>
                                    <td>@(p.Outcome ?? "-")</td>
                                    <td class="text-end @(p.RealizedR >= 0 ? "text-success" : "text-danger")">@(p.State == "CLOSED" ? p.RealizedR.ToString("+0.##;-0.##") : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ---- Today stat cards ---- *@
    <div class="row g-2 my-2" style="max-width:1150px;">
        <div class="col"><div class="card text-center"><div class="card-body py-2">
            <div class="text-muted small">Today Signals</div><h4 class="mb-0">@Model.TodayCount</h4></div></div></div>
        <div class="col"><div class="card text-center border-success"><div class="card-body py-2">
            <div class="text-muted small">Target Hit</div><h4 class="mb-0 text-success">@Model.TodayTarget</h4></div></div></div>
        <div class="col"><div class="card text-center border-danger"><div class="card-body py-2">
            <div class="text-muted small">SL Hit</div><h4 class="mb-0 text-danger">@Model.TodaySL</h4></div></div></div>
        <div class="col"><div class="card text-center"><div class="card-body py-2">
            <div class="text-muted small">Open</div><h4 class="mb-0">@Model.TodayOpen</h4></div></div></div>
    </div>

    @* ---- Aggregate performance + equity curve ---- *@
    <div class="row g-2 my-2" style="max-width:1150px;">
        <div class="col-md-5">
            <div class="card h-100"><div class="card-body py-2">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Performance (@Model.ModeFilter, closed @Model.ClosedCount)</span>
                </div>
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="text-muted small">Win Rate</div>
                        <h5 class="mb-0 @(Model.WinRate >= 50 ? "text-success" : "text-danger")">@Model.WinRate%</h5>
                        <div class="small text-muted">@Model.Wins W / @Model.Losses L · decided @Model.ClosedCount/@Model.TotalCount</div>
                    </div>
                    <div class="col-4">
                        <div class="text-muted small">Net R</div>
                        <h5 class="mb-0 @(Model.TotalR >= 0 ? "text-success" : "text-danger")">@Model.TotalR</h5>
                        <div class="small text-muted">exp @Model.Expectancy R</div>
                    </div>
                    <div class="col-4">
                        <div class="text-muted small">Profit Factor</div>
                        <h5 class="mb-0 @(Model.ProfitFactor >= 1 ? "text-success" : "text-danger")">@Model.ProfitFactor</h5>
                        <div class="small text-muted">@Model.OpenCount open</div>
                    </div>
                </div>
            </div></div>
        </div>
        <div class="col-md-7">
            <div class="card h-100"><div class="card-body py-2">
                <div class="text-muted small mb-1">Equity Curve (cumulative R)</div>
                @{
                    var eq = Model.EquityCurve;
                }
                @if (eq.Count == 0)
                {
                    <div class="text-muted small py-3 text-center">Koi closed trade nahi</div>
                }
                else
                {
                    // SVG scaling
                    const double W = 760, H = 120, pad = 6;
                    double innerW = W - pad * 2, innerH = H - pad * 2;
                    double max = (double)eq.Max(), min = (double)eq.Min();
                    if (max == min) { max += 1; min -= 1; }
                    double range = max - min;
                    int n = eq.Count;
                    double X(int i) => pad + (n == 1 ? innerW / 2 : innerW * i / (n - 1));
                    double Y(double v) => pad + innerH * (max - v) / range;
                    double zeroY = Y(0);
                    var pts = string.Join(" ", eq.Select((v, i) => $"{X(i):0.#},{Y((double)v):0.#}"));
                    double lastVal = (double)eq[^1];
                    string lineColor = lastVal >= 0 ? "#198754" : "#dc3545";
                    <svg viewBox="0 0 @W @H" style="width:100%;height:120px;" preserveAspectRatio="none">
                        @if (zeroY >= pad && zeroY <= H - pad)
                        {
                            <line x1="@pad" y1="@zeroY.ToString("0.#")" x2="@(W - pad)" y2="@zeroY.ToString("0.#")"
                                  stroke="#adb5bd" stroke-width="1" stroke-dasharray="4 3" />
                        }
                        <polyline points="@pts" fill="none" stroke="@lineColor" stroke-width="2"
                                  stroke-linejoin="round" stroke-linecap="round" />
                        <circle cx="@X(n - 1).ToString("0.#")" cy="@Y(lastVal).ToString("0.#")" r="3" fill="@lineColor" />
                    </svg>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>min @min.ToString("0.#")R</span>
                        <span>peak @max.ToString("0.#")R</span>
                        <span class="@(lastVal >= 0 ? "text-success" : "text-danger")">now @lastVal.ToString("0.#")R</span>
                    </div>
                }
            </div></div>
        </div>
    </div>

    @* ---- Per-symbol breakdown ---- *@
    @if (Model.BySymbol.Count > 0)
    {
        <div class="mb-2" style="max-width:1150px;">
            <div class="text-muted small mb-1"><b>Per-symbol (@Model.ModeFilter)</b></div>
            <div style="overflow-x:auto;">
                <table class="table table-sm table-bordered mb-1" style="min-width:600px;">
                    <thead class="table-light">
                        <tr><th>Symbol</th><th class="text-end">Trades</th><th class="text-end">W/L</th>
                            <th class="text-end">Decided</th><th class="text-end">Win%</th><th class="text-end">Net R</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.BySymbol)
                        {
                            <tr>
                                <td style="font-size:0.85rem;">
                                    <a href="@b.DetailUrl" target="_blank" title="Is symbol ka chart + steps dekho">@b.Symbol</a>
                                </td>
                                <td class="text-end">@b.Count</td>
                                <td class="text-end">@b.Wins / @b.Losses</td>
                                <td class="text-end @(b.OpenCount > 0 ? "text-muted" : "")">@b.Decided/@b.Count</td>
                                <td class="text-end">@b.WinRate%</td>
                                <td class="text-end @(b.NetR >= 0 ? "text-success" : "text-danger")"><b>@b.NetR</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Data freshness *@
    <div class="mb-2" style="font-size:0.85rem;">
        <b>Live data (latest 3-min candle):</b>
        @foreach (var f in Model.DataFreshness)
        {
            <span class="badge bg-light text-dark border">@f.sym.Replace("-INDEX", ""): @f.last.ToString("dd-MMM HH:mm")</span>
        }
        @if (Model.DataFreshness.Count == 0) { <span class="text-muted">koi index candle nahi</span> }
    </div>

    <h5 class="mt-3">
        Recent Signals (@Model.Active.Count counted)
        @if (Model.OverlapSkipped > 0)
        {
            <span class="badge bg-secondary" title="Same underlying+direction par pichhla trade abhi open tha — real me nahi lete">@Model.OverlapSkipped overlap</span>
        }
        @if (Model.UsePortfolio && Model.PortfolioSkipped > 0)
        {
            <span class="badge bg-warning text-dark" title="Portfolio rules: ek waqt ek trade / max 2 SL — isliye skip">@Model.PortfolioSkipped portfolio-skip</span>
        }
    </h5>
    <div style="overflow-x:auto;">
        <table class="table table-sm table-bordered" style="min-width:1050px;">
            <thead class="table-dark">
                <tr><th>Date</th><th>Entry</th><th>Option</th><th>Side</th><th>Ref</th>
                    <th>Entry ₹</th><th>SL</th><th>Target</th><th>Outcome</th><th>Hit</th><th>P&amp;L</th><th>R</th><th>Mode</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.TableRows.Take(140))
                {
                    bool skipped = s.IsOverlapSkipped || s.PortfolioSkipped;
                    string cls = skipped ? "table-secondary text-muted"
                               : s.Outcome == "TargetHit" ? "table-success"
                               : s.Outcome == "StopLossHit" ? "table-danger"
                               : s.Outcome == "TimeExit" ? "table-primary" : "table-warning";
                    <tr class="@cls" style="@(skipped ? "opacity:.55;" : "")">
                        <td>@s.EntryTime.ToString("dd-MMM")</td>
                        <td>@s.EntryTime.ToString("HH:mm")</td>
                        <td style="font-size:0.8rem;">
                            <a href="/Strategy/Day?symbol=@Uri.EscapeDataString(s.Symbol)&date=@s.EntryTime.ToString("yyyy-MM-dd")&rr=@s.RR&refStart=@s.RefWindow&entryBuffer=0&slBuffer=0&retracement=50&trailing=false"
                               target="_blank" title="Chart + steps">@s.CleanSymbol</a>
                        </td>
                        <td>@s.Side</td>
                        <td>@s.RefWindow</td>
                        <td>@s.EntryPrice</td>
                        <td>@s.StopLoss</td>
                        <td>@s.Target</td>
                        <td>
                            @if (s.IsOverlapSkipped)
                            {
                                <span class="badge bg-secondary" title="Pichhla trade abhi open tha">⊘ overlap</span>
                            }
                            else if (s.PortfolioSkipped)
                            {
                                <span class="badge bg-warning text-dark" title="@(s.PortfolioSkipReason == "max2SL" ? "Din ke 2 SL ho chuke the" : "Pichhle entry ke 30 min ke andar")">
                                    ⊘ @(s.PortfolioSkipReason == "max2SL" ? "max-2-SL" : "30m-gap")</span>
                            }
                            else
                            {
                                <b>@s.Outcome</b>
                            }
                        </td>
                        <td>@(s.OutcomeTime?.ToString("HH:mm") ?? "-")</td>
                        <td class="@(s.PnlPts >= 0 ? "text-success" : "text-danger")">@(skipped ? "-" : s.PnlPts.ToString())</td>
                        <td class="@(s.RMultiple >= 0 ? "text-success" : "text-danger")">@(skipped || !s.IsClosed ? "-" : s.RMultiple.ToString("0.#"))</td>
                        <td><span class="badge @(s.Mode == "live" ? "bg-primary" : "bg-secondary")">@s.Mode</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.FilteredMarked.Count == 0)
    {
        <div class="alert alert-info">Abhi koi signal nahi (mode: @Model.ModeFilter). Market hours me live signals yahan aayenge, ya backtest &save=true se bhar sakte ho.</div>
    }
}
